# Secure Backend SMTP Configuration
# Copy this file to a new file named '.env' in the portfolio directory.
# Fill in your mail server credentials. Credentials are kept safe on the server.

PORT=5000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email_username_here@gmail.com
SMTP_PASS=your_email_password_or_app_password_here

# (Optional Front-end Direct EmailJS Configuration)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
